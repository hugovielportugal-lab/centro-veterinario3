rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /pedidos/{pedidoId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.uid ||
        request.auth.token.email == 'cvlindaavelha@outlook.com'
      );
      allow update: if request.auth != null &&
        request.auth.token.email == 'cvlindaavelha@outlook.com';
    }
    match /estoque/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /clientes/{uid} {
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.token.email == 'cvlindaavelha@outlook.com');
    }
    match /avisos_stock/{docId} {
      allow create: if true;
      allow read, delete: if request.auth != null && request.auth.token.email == 'cvlindaavelha@outlook.com';
    }
    match /compras/{docId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }
    match /avaliacoes/{docId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid
        && exists(/databases/$(database)/documents/compras/$(request.auth.uid + '_' + request.resource.data.produtoId));
      allow update, delete: if request.auth != null
        && (request.auth.uid == resource.data.uid || request.auth.token.email == 'cvlindaavelha@outlook.com');
    }
    match /galeria/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.token.email == 'cvlindaavelha@outlook.com';
    }
    match /artigos/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.token.email == 'cvlindaavelha@outlook.com';
    }
    match /avisos_abertura/{docId} {
      allow create: if true;
      allow read, delete: if request.auth != null
        && request.auth.token.email == 'cvlindaavelha@outlook.com';
    }
    match /cupoes/{codigo} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'cvlindaavelha@outlook.com';
    }
    match /cupons_usados/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }
  }
}
